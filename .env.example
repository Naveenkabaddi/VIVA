# ---------------------------------------------------------------------------
# AI Viva Preparation Platform - environment configuration
# Copy this file to .env (repository root) before starting the backend.
# Never commit .env or real API keys.
# ---------------------------------------------------------------------------

APP_NAME="AI Viva Preparation Platform"
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite works out of the box. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://viva:password@localhost:5432/viva
DATABASE_URL=sqlite:///./viva.db
# Run `alembic upgrade head` automatically at startup (recommended).
# Set false if migrations are applied by a separate deployment step.
AUTO_MIGRATE=true

# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini. Leave empty to run the built-in offline examiner engine.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Embeddings: auto | sentence-transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage
UPLOAD_DIR=./storage/uploads
VECTOR_DIR=./storage/vectors
MAX_UPLOAD_MB=20

# API protection
RATE_LIMIT_PER_MINUTE=120

# Evaluation weights (must sum to 1.0)
SCORE_WEIGHT_ACCURACY=0.30
SCORE_WEIGHT_RELEVANCE=0.20
SCORE_WEIGHT_COMPLETENESS=0.20
SCORE_WEIGHT_UNDERSTANDING=0.20
SCORE_WEIGHT_CLARITY=0.10

# Optional speech-to-text language hint
WHISPER_MODEL=base
